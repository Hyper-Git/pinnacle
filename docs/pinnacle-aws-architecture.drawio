          <mxGeometry x="1640" y="354" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="leg-step4">
          <mxGeometry width="40" height="38" y="2" as="geometry" />
        </mxCell>
        <mxCell id="leg-desc4" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Database Queries&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;EC2 instances query RDS PostgreSQL 16 on :5432. EC2 SG ingress is locked to EC2 security group only — no direct external access.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-step4">
          <mxGeometry x="52" width="468" height="80" as="geometry" />
        </mxCell>

        <!-- Step 5 legend -->
