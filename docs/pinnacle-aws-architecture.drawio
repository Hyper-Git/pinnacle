        <mxCell id="leg-desc7" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;CI/CD Artifact Upload&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;GitHub Actions authenticates via OIDC (no static keys). Packages app as app-{SHA}.zip and uploads to the S3 deployment bucket.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-step7">
          <mxGeometry x="52" width="468" height="80" as="geometry" />
