          <mxGeometry x="1640" y="442" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="leg-step5">
          <mxGeometry width="40" height="38" y="2" as="geometry" />
        </mxCell>
        <mxCell id="leg-desc5" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Management Access (No SSH)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;SSM Session Manager provides shell access via NAT Gateway. No key pairs, no bastion host, no port 22 open anywhere.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-step5">
          <mxGeometry x="52" width="468" height="80" as="geometry" />
        </mxCell>

        <!-- Step 6 legend -->
