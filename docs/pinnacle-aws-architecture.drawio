        <mxCell id="leg-desc1" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;DNS Resolution&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;User browser queries Route 53 for pinnacle.cornelcloud.net. Route 53 returns an alias record pointing to the ALB DNS name.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-step1">
          <mxGeometry x="52" width="468" height="80" as="geometry" />
        </mxCell>

        <!-- Step 2 legend -->
        <mxCell id="leg-step2" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="1">
          <mxGeometry x="1640" y="178" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="leg-step2">
          <mxGeometry width="40" height="38" y="2" as="geometry" />
        </mxCell>
        <mxCell id="leg-desc2" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;HTTPS Termination&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ALB receives HTTPS traffic on :443. TLS is terminated using the ACM certificate. HTTP :80 is permanently redirected to HTTPS.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-step2">
          <mxGeometry x="52" width="468" height="80" as="geometry" />
        </mxCell>

        <!-- Step 3 legend -->
        <mxCell id="leg-step3" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="1">
          <mxGeometry x="1640" y="266" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="leg-badge3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="leg-step3">
          <mxGeometry width="40" height="38" y="2" as="geometry" />
        </mxCell>
        <mxCell id="leg-desc3" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Traffic Forwarding&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ALB health-checks EC2 instances on /health and forwards HTTP :8080 to healthy targets. Target group spans all 3 AZs.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-step3">
          <mxGeometry x="52" width="468" height="80" as="geometry" />
        </mxCell>

