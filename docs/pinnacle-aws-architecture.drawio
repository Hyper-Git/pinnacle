        </mxCell>
        <mxCell id="leg-badge6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="leg-step6">
          <mxGeometry width="40" height="38" y="2" as="geometry" />
        </mxCell>
        <mxCell id="leg-desc6" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;In-Memory Secrets&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;On boot, EC2 calls Secrets Manager via NAT Gateway to fetch DB credentials into process memory. Nothing is written to EBS disk.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-step6">
          <mxGeometry x="52" width="468" height="80" as="geometry" />
        </mxCell>

